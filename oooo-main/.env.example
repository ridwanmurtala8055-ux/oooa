# Core
DATABASE_URL=postgres://postgres:replace_with_strong_password@localhost:5432/coinhunter

# Security
WALLET_MASTER_KEY=replace_with_64_hex_chars
PIN_HASH_PEPPER=replace_with_48_hex_chars

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
API_BASE=http://localhost:8080

# Solana / execution (devnet defaults for testing)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
USE_JUPITER=true
SHIELD_MODE=false
WITHDRAW_MIN_USD=10
WITHDRAW_FEE_BUFFER_SOL=0.001

# Forex EA bridge
EA_SHARED_SECRET=replace_with_long_random_secret

# Payments
PAYMENT_RECEIVER_WALLET=replace_with_your_wallet_address
